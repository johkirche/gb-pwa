{
  "name": "gb-pwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build-only": "vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc -b",
    "type-check:test": "vue-tsc -p tsconfig.vitest.json --noEmit",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "ci:lint": "oxlint . -D correctness --ignore-path .gitignore && eslint .",
    "ci:verify": "run-s ci:lint type-check type-check:test test:coverage",
    "format": "prettier --write src/",
    "build:emoji-data": "node scripts/build-merged-emoji-data.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "test:known-issues": "vitest run --config vitest.known-issues.config.ts"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@liripeng/vue-audio-player": "^2.0.4",
    "@panzoom/panzoom": "^4.6.0",
    "@tailwindcss/vite": "^4.1.10",
    "@tanstack/vue-virtual": "^3.13.12",
    "@vueuse/core": "^13.3.0",
    "@vueuse/sound": "^2.1.3",
    "axios": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gql-query-builder": "^3.8.0",
    "graphql": "^16.11.0",
    "lucide-vue-next": "^0.515.0",
    "opensheetmusicdisplay": "^1.9.9",
    "pinia": "^3.0.4",
    "reka-ui": "^2.3.1",
    "spessasynth_lib": "^4.3.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.10",
    "tw-animate-css": "^1.3.4",
    "vue": "^3.5.13",
    "vue-frimousse": "^0.1.4",
    "vue-i18n": "11.1.6",
    "vue-router": "4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@graphql-codegen/cli": "^5.0.7",
    "@pinia/testing": "^1.0.3",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@tsconfig/node22": "^22.0.1",
    "@types/node": "^24.0.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "emojibase-data": "^17.0.0",
    "eslint": "^9.29.0",
    "eslint-plugin-oxlint": "^0.16.0",
    "eslint-plugin-vue": "^10.2.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "lint-staged": "^16.2.7",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^0.16.0",
    "png-to-ico": "^3.0.1",
    "prettier": "3.5.3",
    "sharp": "^0.34.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.8",
    "workbox-window": "7.3.0"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --cache --fix",
      "vitest related --run --passWithNoTests"
    ],
    "*.{js,css,md}": "prettier --write"
  }
}
